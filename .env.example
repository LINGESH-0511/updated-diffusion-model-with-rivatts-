# Copy this file to .env and fill in your real keys.
# NEVER commit the .env file — it is in .gitignore.

GROQ_API_KEY=gsk_your_groq_key_here
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here
NGC_API_KEY=nvapi-your_ngc_key_here

A2F_GRPC_HOST=127.0.0.1
A2F_GRPC_PORT=52000
A2F_HTTP_HOST=127.0.0.1
A2F_HTTP_PORT=8000

LOG_LEVEL=INFO
